# Public storefront URL used for metadata and Shopify customer-account callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shopify Headless / Storefront API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=replace_with_server_only_token
SHOPIFY_API_VERSION=2026-07

# Shopify Customer Account API (passwordless email-code sign-in)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=replace_with_customer_account_client_id
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=replace_with_server_only_client_secret
SHOPIFY_CUSTOMER_ACCOUNT_CALLBACK_URL=http://localhost:3000/account/callback

# Used to verify Shopify webhook signatures on the server.
SHOPIFY_WEBHOOK_SECRET=replace_with_server_only_webhook_secret

# Paystack is configured as a payment provider inside Shopify.
# Do not add a Paystack secret key to the storefront or expose one with NEXT_PUBLIC_.
